#!/bin/sh

PROJECT=`basename $0`

usage()
{
	echo "usage: $PROJECT [version] app" >&2
	exit 1
}

while `dirname $0`/args $@; do
	case $1 in
	*) usage ;;
	esac
	shift
done

test $# -eq 2 && { VER=$1; shift; }
APP=`echo $1 | tr A-Z a-z`

NAME=msoffice$VER

case $APP in
               word) EXE=WINWORD  ;;
              excel) EXE=EXCEL    ;;
pp|power|powerpoint) EXE=POWERPNT ;;
            outlook) EXE=OUTLOOK  ;;
       note|onenote) EXE=ONENOTE  ;;
              visio) EXE=VISIO    ;;
esac

JAIL=/usr/local/jails/containers/$NAME
X11=.X11-unix

doas -u anton /usr/local/bin/xhost +local:$NAME
test -e $JAIL/tmp/$X11/X0 || {
	mkdir -p $JAIL/tmp/$X11
	mount -t nullfs -o nocover /tmp/$X11 $JAIL/tmp/$X11
}

EXE="/root/.wine/drive_c/Program\ Files/Microsoft\ Office/Office12/$EXE.EXE"
jexec $NAME /bin/sh -c "DISPLAY=:0 wine $EXE"
